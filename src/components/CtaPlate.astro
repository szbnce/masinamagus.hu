---
/**
 * Záró CTA-tábla — a szöveg l10n-ből érkezik (hívási oldalon t()).
 */
import Screws from './Screws.astro';
import Icon from './Icon.astro';

interface Props {
  heading: string;
  text: string;
  button: string;
}

const { heading, text, button } = Astro.props;
---

<div class="plate plate--red cta-plate">
  <Screws />
  <h2>{heading}</h2>
  <p class="cta-plate__text">{text}</p>
  <a class="btn btn--primary" href="/kapcsolat">{button}</a>
  <p class="cta-plate__phone">
    <a class="mono" href="tel:+36703031020">+36 70 303 1020</a>
  </p>
</div>

<style>
  .cta-plate {
    text-align: center;
    padding-block: clamp(34px, 5vw, 58px);
  }
  .cta-plate__text {
    margin-inline: auto;
    color: rgba(239, 234, 216, 0.85);
    max-width: 60ch;
  }
  .cta-plate__phone {
    margin: 18px 0 0;
  }
  .cta-plate__phone a {
    color: var(--on-dark);
    font-size: clamp(22px, 2.6vw, 32px);
    letter-spacing: 0.02em;
    text-decoration-color: var(--brass);
  }
  .cta-plate__phone a:hover {
    color: var(--brass);
  }
</style>
