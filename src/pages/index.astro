---
// Főoldal — Zománctábla-műhely (első képernyő: safer-zomanc.html kompozíció,
// wordmark: wm-zomanc). Irány: .impeccable/surfaces/src-pages-index-astro.md
// Minden UI-szöveg az l10n rétegből (AGENTS.md).
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import Screws from '../components/Screws.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import SavingsCalc from '../components/SavingsCalc';
import { t, l10n } from '../lib/l10n';
import { services } from '../data/services';
import blogData from '../content/blogData.json';

interface TrustItem {
  icon: string;
  title: string;
  text: string;
}
interface DemoRow {
  metric: string;
  before: string;
  after: string;
  delta: string;
}
interface ProcessStep {
  num: string;
  title: string;
  description: string;
}
interface FaqItem {
  q: string;
  a: string;
}
interface RefItem {
  title: string;
  text: string;
}
interface HeroStat {
  num: string;
  unit: string;
  label: string;
}
interface TableRow {
  title: string;
  col1: string;
  col2: string;
}

const bundle = l10n as unknown as {
  hero: { stats: HeroStat[] };
  trust: { label: string; items: TrustItem[] };
  home: { demo: { rows: DemoRow[] } };
  process: { steps: ProcessStep[] };
  faq: { items: FaqItem[] };
  references: {
    items: RefItem[];
    proof: string[];
    reviews_title: string;
    reviews: { name: string; car: string; quote: string }[];
  };
  about: {
    table_rows: TableRow[];
  };
  services: {
    items: { title: string; description: string; icon: string; slug: string }[];
  };
};

// Szolgáltatás-kártyák: services.ts (slug, cím) + services.items (leírás, ikon)
const serviceCards = services.map((s, i) => ({
  slug: s.slug,
  titleKey: s.titleKey,
  description: bundle.services.items[i].description,
  icon: bundle.services.items[i].icon as IconName,
}));

// A főoldal jobb oldali kisebb táblái (első képernyő)
const stackSlugs = [
  'chiptuning-stage-1',
  'eco-tuning-fogyasztascsokkentes',
  'egr-dpf-szoftveres-megoldasok',
  'adblue-szoftveres-javitas',
] as const;
const stackFacts: Record<string, string> = {
  'chiptuning-stage-1': t('home.plates.stage1.fact'),
  'eco-tuning-fogyasztascsokkentes': t('home.plates.eco.fact'),
  'egr-dpf-szoftveres-megoldasok': t('home.plates.dpfegr.fact'),
  'adblue-szoftveres-javitas': t('home.plates.adblue.fact'),
};

const blogTeasers = blogData.slice(0, 3);
---

<BaseLayout title={t('home.meta.title')} description={t('home.meta.description')}>
  <!-- ============ ELSŐ KÉPERNYŐ ============ -->
  <section class="hero shell" aria-label={t('home.world.hero_h1')}>
    <div class="hero__grid">
      <div class="hero__main plate plate--cream settle settle-1">
        <Screws />
        <div class="sheen-sweep" aria-hidden="true"></div>
        <h1 class="hero__h1">
          <Wordmark size="xl" />
          <span class="visually-hidden"> — {t('home.world.hero_h1')}</span>
        </h1>
        <p class="hero__slogan mono">{t('home.world.slogan')}</p>
        <a class="hero__phone mono" href="tel:+36703031020">{t('footer.phone')}</a>
        <p class="hero__note mono">{t('home.world.note')}</p>
      </div>

      <div class="hero__stack">
        {
          stackSlugs.map((slug, i) => {
            const card = serviceCards.find((c) => c.slug === slug)!;
            return (
              <a
                class:list={[
                  'plate',
                  slug === 'egr-dpf-szoftveres-megoldasok' ? 'plate--red' : 'plate--blue',
                  'plate--interactive',
                  'hero__svc',
                  `settle`,
                  `settle-${i + 2}`,
                ]}
                href={`/szolgaltatasok/${card.slug}`}
              >
                <Screws />
                <h2 class="hero__svc-title">{t(card.titleKey)}</h2>
                <p class="plate__fact">{stackFacts[slug]}</p>
              </a>
            );
          })
        }
      </div>

      <div class="hero__medal settle settle-5">
        <p class="hero__medal-l1 mono">{t('home.medal.line1')}</p>
        <p class="hero__medal-l2">{t('home.medal.line2')}</p>
      </div>

      <div class="hero__cta plate plate--cream settle settle-5">
        <Screws />
        <a class="btn btn--primary" href="/kapcsolat">{t('home.world.cta_primary')}</a>
        <a class="btn btn--secondary btn--on-cream" href="/szolgaltatasok">
          {t('home.world.cta_secondary')}
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ BIZALOM-ÍGÉRETEK ============ -->
  <section class="section shell">
    <div class="section__head">
      <h2>{t('trust.label')}</h2>
    </div>
    <div class="plate plate--cream notice settle">
      <Screws />
      <ul class="notice__stats mono">
        {
          bundle.hero.stats.map((s) => (
            <li>
              <span class="notice__stat-num">{s.num}</span>
              <span class="notice__stat-unit">{s.unit}</span>
              <span class="notice__stat-label">{s.label}</span>
            </li>
          ))
        }
      </ul>
      <ul class="notice__rows">
        {
          bundle.trust.items.map((item) => (
            <li class="notice__row">
              <Icon name={item.icon as IconName} size={28} />
              <div>
                <h3 class="notice__row-title">{item.title}</h3>
                <p class="notice__row-text">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ KIFÜGGESZTETT MÉRT ÉRTÉK ============ -->
  <section class="section shell">
    <div class="demo">
      <div class="demo__display">
        <h2 class="demo__title">{t('home.demo.title')}</h2>
        <p class="demo__lead">{t('home.demo.lead')}</p>
        <p class="wall-note">{t('home.demo.archived')}</p>
      </div>
      <div class="plate plate--cream demo__plate settle">
        <Screws />
        <p class="plate__label">{t('home.demo.label')}</p>
        <table class="data-table demo__table">
          <thead>
            <tr>
              <th scope="col">{t('home.demo.col_metric')}</th>
              <th scope="col" class="num">{t('home.demo.col_before')}</th>
              <th scope="col" class="num">{t('home.demo.col_after')}</th>
              <th scope="col" class="num">{t('home.demo.col_delta')}</th>
            </tr>
          </thead>
          <tbody>
            {
              bundle.home.demo.rows.map((r) => (
                <tr>
                  <th scope="row">{r.metric}</th>
                  <td class="num">{r.before}</td>
                  <td class="num demo__after">{r.after}</td>
                  <td class="num demo__delta">{r.delta}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="demo__foot mono">{t('home.demo.foot')}</p>
      </div>
    </div>
  </section>

  <!-- ============ SZOLGÁLTATÁSOK ============ -->
  <section class="section shell" id="szolgaltatasok">
    <div class="section__head">
      <h2>
        {t('services.title')}{' '}
        <span class="mark">{t('services.title_mark')}</span>
      </h2>
      <p class="section__lead">{t('services.lead')}</p>
    </div>
    <div class="plate-grid">
      {
        serviceCards.map((card) => (
          <a
            class:list={[
              'plate',
              card.slug === 'egr-dpf-szoftveres-megoldasok' || card.slug === 'adblue-szoftveres-javitas'
                ? 'plate--red'
                : 'plate--blue',
              'plate--interactive',
              'svc-card',
            ]}
            href={`/szolgaltatasok/${card.slug}`}
          >
            <Screws />
            <Icon name={card.icon} size={32} />
            <h3 class="svc-card__title">{t(card.titleKey)}</h3>
            <p class="plate__fact">{card.description}</p>
            <span class="svc-card__more">
              {t('services.more_link')}
              <Icon name="arrow-right" size={18} />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ FOLYAMAT ============ -->
  <section class="section shell">
    <div class="section__head">
      <h2>
        {t('process.title_a')}{' '}
        <span class="mark">{t('process.title_mark')}</span>
      </h2>
    </div>
    <ol class="steps">
      {
        bundle.process.steps.map((step) => (
          <li class="plate plate--cream plate--interactive step">
            <Screws />
            <p class="step__num mono">{step.num}</p>
            <h3 class="step__title">{step.title}</h3>
            <p class="plate__fact">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============ RÓLUNK ============ -->
  <section class="section shell">
    <div class="section__head">
      <h2>
        {t('about.title_a')}{' '}
        <span class="mark">{t('about.title_mark')}</span>{' '}
        {t('about.title_b')}
      </h2>
      <p class="section__lead">{t('about.intro')}</p>
      <p class="about__tagline mono">{t('about.tagline')}</p>
    </div>

    <div class="about__duo">
      <div class="plate plate--blue">
        <Screws />
        <h3>{t('about.profile_1_name')}</h3>
        <p class="plate__label">{t('about.profile_1_role')}</p>
        <p class="plate__fact">{t('about.profile_1_desc')}</p>
      </div>
      <div class="plate plate--blue">
        <Screws />
        <h3>{t('about.profile_2_name')}</h3>
        <p class="plate__label">{t('about.profile_2_role')}</p>
        <p class="plate__fact">{t('about.profile_2_desc')}</p>
      </div>
    </div>

    <div class="plate plate--cream about__table-plate">
      <Screws />
      <h3>
        {t('about.table_title_a')}{' '}
        <span class="mark">{t('about.table_title_mark')}</span>{' '}
        {t('about.table_title_b')}
      </h3>
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">{t('about.table_header_1')}</th>
            <th scope="col">{t('about.table_header_2')}</th>
            <th scope="col">{t('about.table_header_3')}</th>
          </tr>
        </thead>
        <tbody>
          {
            bundle.about.table_rows.map((row) => (
              <tr>
                <th scope="row">{row.title}</th>
                <td>{row.col1}</td>
                <td class="about__muted">{row.col2}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============ REFERENCIÁK / MUNKATÍPUSOK ============ -->
  <section class="section shell">
    <div class="section__head">
      <h2>
        {t('references.title_a')}{' '}
        <span class="mark">{t('references.title_mark')}</span>
      </h2>
      <p class="section__lead">{t('references.lead')}</p>
    </div>
    <div class="plate-grid refs">
      {
        bundle.references.items.map((item) => (
          <div class="plate plate--red">
            <Screws />
            <h3>{item.title}</h3>
            <p class="plate__fact">{item.text}</p>
          </div>
        ))
      }
    </div>
    <div class="plate plate--cream proof">
      <Screws />
      <h3>{t('references.proof_title')}</h3>
      <ul class="proof__list">
        {
          bundle.references.proof.map((line) => (
            <li>
              <Icon name="check" size={22} />
              {line}
            </li>
          ))
        }
      </ul>
      <a class="btn btn--secondary btn--on-cream" href="/kapcsolat">
        {t('references.cta')}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>

    <h3 class="reviews__title">{t('references.reviews_title')}</h3>
    <div class="plate-grid refs-reviews">
      {
        bundle.references.reviews.map((r) => (
          <figure class="plate plate--cream review">
            <Screws />
            <blockquote class="review__quote">
              <p>{r.quote}</p>
            </blockquote>
            <figcaption class="review__by mono">
              {r.name} · {r.car}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ============ KALKULÁTOR ============ -->
  <section class="section shell">
    <div class="calc-wrap plate plate--cream">
      <Screws />
      <h2>{t('calc.title')}</h2>
      <p class="section__lead">{t('calc.lead')}</p>
      <SavingsCalc client:load />
    </div>
  </section>

  <!-- ============ GYIK ============ -->
  <section class="section shell">
    <div class="section__head">
      <h2>
        {t('faq.title_a')}{' '}
        <span class="mark">{t('faq.title_mark')}</span>
      </h2>
    </div>
    <div class="faq">
      {
        bundle.faq.items.map((item) => (
          <details class="faq__item plate plate--cream">
            <Screws />
            <summary class="faq__q">{item.q}</summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  <section class="section shell">
    <div class="section__head">
      <h2>
        {t('blog.hero.title_a')}{' '}
        <span class="mark">{t('blog.hero.title_mark')}</span>
      </h2>
      <p class="section__lead">{t('blog.hero.subtitle')}</p>
    </div>
    <div class="plate-grid">
      {
        blogTeasers.map((post) => (
          <a class="plate plate--blue plate--interactive" href={`/blog/${post.slug}`}>
            <Screws />
            <h3>{post.title}</h3>
            <p class="plate__fact">{post.description}</p>
            <p class="blog__meta mono">{post.category} · {post.readingTime}</p>
          </a>
        ))
      }
    </div>
    <p class="blog__all">
      <a class="btn btn--secondary" href="/blog">
        {t('blog.all')}
        <Icon name="arrow-right" size={18} />
      </a>
    </p>
  </section>

  <!-- ============ KAPCSOLAT CTA ============ -->
  <section class="section shell">
    <div class="plate plate--red contact-cta">
      <Screws />
      <h2>
        {t('contact.title_a')}{' '}
        <span class="mark mark--light">{t('contact.title_mark')}</span>
      </h2>
      <p class="contact-cta__lead">{t('contact.lead')}</p>
      <a class="contact-cta__phone mono" href="tel:+36703031020">{t('footer.phone')}</a>
      <div class="contact-cta__actions">
        <a class="btn btn--primary" href="/kapcsolat">{t('home.world.cta_primary')}</a>
        <a class="btn btn--secondary" href="mailto:info@masinamagus.hu">
          {t('footer.email')}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Első képernyő (safer-zomanc kompozíció) ---------- */
  .hero {
    padding-block: clamp(18px, 3vh, 40px) clamp(30px, 5vh, 56px);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-areas:
      'main stack'
      'medal cta';
    gap: clamp(16px, 2vw, 26px);
    align-items: stretch;
  }
  .hero__main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 56px);
  }
  .hero__stack {
    grid-area: stack;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: clamp(12px, 1.6vw, 22px);
  }
  .hero__svc {
    padding: clamp(24px, 2vw, 28px);
  }
  .hero__svc-title {
    font-size: clamp(19px, 1.7vw, 26px);
    margin: 0 0 0.3em;
  }
  .hero__medal {
    grid-area: medal;
    justify-self: start;
    align-self: end;
    background: var(--cream);
    color: var(--oxblood);
    border: 7px solid var(--oxblood);
    border-radius: 100px;
    padding: 18px 34px;
    text-align: center;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.45);
  }
  .hero__medal-l1 {
    margin: 0;
    font-size: clamp(12px, 2.8vw, 15px);
    letter-spacing: 0.16em;
  }
  .hero__medal-l2 {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: clamp(12px, 2.8vw, 15px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero__cta {
    grid-area: cta;
    justify-self: end;
    align-self: end;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    padding: clamp(18px, 2vw, 28px) clamp(22px, 2.4vw, 34px);
  }
  .hero__cta .btn {
    font-size: clamp(15px, 1.3vw, 19px);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .hero__h1 {
    margin: 0;
    line-height: 1;
    text-transform: none;
  }
  .hero__slogan {
    margin: 20px 0 0;
    font-size: clamp(12px, 3vw, 22px);
    letter-spacing: clamp(0.06em, 1vw, 0.16em);
    color: var(--cast-2);
    font-weight: 500;
  }
  .hero__phone {
    display: inline-block;
    margin: 18px 0 0;
    font-size: clamp(26px, 7.6vw, 72px);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
    color: var(--cast);
    text-decoration: none;
    border-bottom: 5px solid var(--oxblood);
    padding-bottom: 6px;
  }
  .hero__phone:hover {
    color: var(--oxblood);
  }
  .hero__note {
    margin: 18px 0 0;
    font-size: clamp(11px, 2.6vw, 14px);
    letter-spacing: 0.14em;
    color: var(--cast-2);
  }

  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'main'
        'stack'
        'cta'
        'medal';
    }
    .hero__stack {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
    }
    .hero__cta {
      justify-self: stretch;
      justify-content: space-between;
    }
    .hero__medal {
      justify-self: center;
    }
  }
  @media (max-width: 560px) {
    .hero__stack {
      grid-template-columns: 1fr;
    }
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* ---------- Szekciócímek ---------- */
  .mark {
    color: var(--brass);
  }
  .mark--light {
    color: var(--cream);
  }
  .section__lead {
    color: var(--parchment);
    max-width: 62ch;
    font-size: clamp(17px, 1.5vw, 20px);
  }

  /* ---------- Bizalom-tábla ---------- */
  .notice__stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 56px);
    margin: 0 0 clamp(22px, 3vw, 34px);
    padding: 0 0 clamp(18px, 2.4vw, 26px);
    border-bottom: 2px solid rgba(46, 42, 36, 0.16);
  }
  .notice__stats li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .notice__stat-num {
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 600;
    color: var(--oxblood);
  }
  .notice__stat-unit {
    font-size: 18px;
    color: var(--cast-2);
  }
  .notice__stat-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 14px;
    color: var(--cast-2);
  }
  .notice__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(18px, 2.6vw, 28px);
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 760px) {
    .notice__rows {
      grid-template-columns: 1fr;
    }
  }
  .notice__row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .notice__row :global(.icon) {
    color: var(--oxblood);
    margin-top: 3px;
  }
  .notice__row-title {
    margin: 0 0 0.25em;
    font-size: 21px;
  }
  .notice__row-text {
    margin: 0;
    color: var(--cast-2);
  }

  /* ---------- Mért érték demó ---------- */
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(24px, 3.4vw, 48px);
    align-items: center;
  }
  @media (max-width: 900px) {
    .demo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .demo__title {
    font-size: clamp(34px, 4.4vw, 60px);
  }
  .demo__lead {
    color: var(--parchment);
    max-width: 52ch;
  }
  .demo__plate {
    padding-top: clamp(26px, 3vw, 40px);
    overflow-x: auto;
  }
  .demo__table {
    min-width: 420px;
  }
  .demo__table {
    margin-top: 14px;
  }
  .demo__after {
    font-weight: 600;
    color: var(--oxblood);
  }
  .demo__delta {
    color: var(--oxblood);
    font-weight: 600;
  }
  .demo__foot {
    margin: 16px 0 0;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--cast-2);
    text-transform: uppercase;
  }

  /* ---------- Szolgáltatás-kártyák ---------- */
  .plate-grid {
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  }
  .svc-card :global(.icon) {
    color: var(--brass);
  }
  .svc-card__title {
