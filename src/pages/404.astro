---
// 404 — az oldal nem található (notfound.* l10n-kulcsok).
import BaseLayout from '../layouts/BaseLayout.astro';
import Screws from '../components/Screws.astro';
import Icon from '../components/Icon.astro';
import { t } from '../lib/l10n';
---

<BaseLayout title={t('notfound.meta_title')} description={t('notfound.subtitle')}>
  <section class="nf shell">
    <div class="plate plate--cream nf__plate">
      <Screws />
      <p class="nf__code mono">404</p>
      <h1>
        {t('notfound.title_a')}{' '}
        <span class="mark">{t('notfound.title_mark')}</span>
      </h1>
      <p class="nf__sub">{t('notfound.subtitle')}</p>
      <nav class="nf__links" aria-label={t('navbar.main_nav')}>
        <a class="btn btn--primary" href="/">{t('notfound.home')}</a>
        <a class="btn btn--secondary btn--on-cream" href="/szolgaltatasok">
          {t('notfound.services')}
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--secondary btn--on-cream" href="/blog">
          {t('notfound.blog')}
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--secondary btn--on-cream" href="/kapcsolat">
          {t('notfound.contact')}
          <Icon name="arrow-right" size={18} />
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(40px, 8vw, 110px);
  }
  .nf__plate {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
    padding-block: clamp(38px, 6vw, 70px);
  }
  .nf__code {
    margin: 0 0 6px;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 600;
    color: var(--oxblood);
    letter-spacing: 0.08em;
  }
  .mark {
    color: var(--oxblood);
  }
  .nf__sub {
    margin-inline: auto;
    color: var(--cast-2);
    max-width: 52ch;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: center;
    align-items: center;
    margin-top: 26px;
  }
</style>
