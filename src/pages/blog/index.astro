---
// Blog lista + hírlevél-szekció (jelenleg mailto — provider később dől el).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Screws from '../../components/Screws.astro';
import Icon from '../../components/Icon.astro';
import { t } from '../../lib/l10n';
import blogData from '../../content/blogData.json';

const posts = blogData;
---

<BaseLayout title={t('blog.meta.title')} description={t('blog.meta.description')}>
  <header class="page-hero shell">
    <h1>
      {t('blog.hero.title_a')}{' '}
      <span class="mark">{t('blog.hero.title_mark')}</span>
    </h1>
    <p class="page-hero__lead">{t('blog.hero.subtitle')}</p>
  </header>

  <section class="section shell">
    <div class="plate-grid">
      {
        posts.map((post) => (
          <a class="plate plate--blue plate--interactive post-card" href={`/blog/${post.slug}`}>
            <Screws />
            <h2 class="post-card__title">{post.title}</h2>
            <p class="plate__fact">{post.description}</p>
            <p class="post-card__meta mono">
              {post.category} · {post.readingTime} · {post.author}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section shell">
    <div class="plate plate--cream newsletter-plate">
      <Screws />
      <h2>
        {t('newsletter.title_a')}{' '}
        <span class="mark mark--ox">{t('newsletter.title_mark')}</span>
      </h2>
      <p class="newsletter-plate__sub">{t('newsletter.subtitle')}</p>
      <form
        class="newsletter-form"
        id="newsletter-form"
        data-subject={t('newsletter.mail_subject')}
        data-mailto="info@masinamagus.hu"
      >
        <div class="newsletter-form__row">
          <label for="newsletter-email">{t('newsletter.email_label')}</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder={t('newsletter.email_placeholder')}
            data-error-required={t('newsletter.required_email')}
          />
        </div>
        <label class="newsletter-form__consent">
          <input
            type="checkbox"
            name="consent"
            required
            data-error-required={t('newsletter.required_consent')}
          />
          <span>
            {t('newsletter.consent_prefix')}
            <a href="/gdpr">{t('newsletter.consent_link')}</a>
            {t('newsletter.consent_suffix')}
          </span>
        </label>
        <button class="btn btn--primary" type="submit">{t('newsletter.submit')}</button>
        <p class="newsletter-form__note">{t('newsletter.mailto_note')}</p>
      </form>
    </div>
  </section>

  <section class="section shell">
    <div class="plate plate--red cta-strip">
      <Screws />
      <h2>{t('blog.cta.heading')}</h2>
      <p>{t('blog.cta.text')}</p>
      <a class="btn btn--primary" href="/kapcsolat">{t('blog.cta.button')}</a>
    </div>
  </section>
</BaseLayout>

<script>
  // A hírlevél űrlap mailt nyit (mailto) — nincs szerveroldali tárolás.
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const email = form.querySelector<HTMLInputElement>('#newsletter-email');
    const consent = form.querySelector<HTMLInputElement>('input[name="consent"]');
    for (const field of [email, consent]) {
      if (!field) continue;
      const err = field.dataset.errorRequired ?? '';
      field.setCustomValidity(field.validity.valueMissing ? err : '');
    }
    if (!form.reportValidity() || !email) return;
    const subject = form.dataset.subject ?? '';
    const mailto = form.dataset.mailto ?? '';
    const body = `${email.value}`;
    window.location.href = `mailto:${mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .page-hero {
    padding-block: clamp(26px, 4vw, 52px) 0;
  }
  .mark {
    color: var(--brass);
  }
  .mark--ox {
    color: var(--oxblood);
  }
  .page-hero__lead {
    color: var(--parchment);
    font-size: clamp(18px, 1.7vw, 22px);
    max-width: 62ch;
    margin-top: 18px;
  }
  .post-card {
    display: flex;
    flex-direction: column;
  }
  .post-card__title {
    margin: 0 0 0.35em;
    font-size: clamp(19px, 1.8vw, 25px);
  }
  .post-card__meta {
    margin: auto 0 0;
    padding-top: 16px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .newsletter-plate__sub {
    color: var(--cast-2);
    max-width: 62ch;
  }
  .newsletter-form {
    display: grid;
    gap: 16px;
    max-width: 560px;
  }
  .newsletter-form__row {
    display: grid;
    gap: 8px;
  }
  .newsletter-form label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 14px;
    color: var(--cast-2);
  }
  .newsletter-form input[type='email'] {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 18px;
    padding: 13px 15px;
    border: 3px solid var(--cast);
    border-radius: 10px;
    background: #fff;
    color: var(--cast);
  }
  .newsletter-form__consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    text-transform: none !important;
    letter-spacing: 0 !important;
    font-family: var(--font-body) !important;
    font-size: 15px !important;
    color: var(--cast-2) !important;
  }
  .newsletter-form__consent input {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    accent-color: var(--oxblood);
    flex: none;
  }
  .newsletter-form__consent a {
    color: var(--oxblood);
  }
  .newsletter-form .btn {
    justify-self: start;
  }
  .newsletter-form__note {
    margin: 0;
    font-size: 14px;
    color: var(--cast-2);
  }

  .cta-strip {
    text-align: center;
    padding-block: clamp(34px, 5vw, 58px);
  }
  .cta-strip p {
    color: rgba(239, 234, 216, 0.85);
    margin-inline: auto;
    max-width: 60ch;
  }
</style>
