---
// Szakszótár — kereshető lista (GlossarySearch React-sziget).
import BaseLayout from '../layouts/BaseLayout.astro';
import Screws from '../components/Screws.astro';
import GlossarySearch from '../components/GlossarySearch';
import { t } from '../lib/l10n';
---

<BaseLayout title={t('glossary.meta.title')} description={t('glossary.meta.description')}>
  <header class="page-hero shell">
    <h1>
      {t('glossary.hero.title_a')}{' '}
      <span class="mark">{t('glossary.hero.title_mark')}</span>
    </h1>
    <p class="page-hero__lead">{t('glossary.hero.subtitle')}</p>
  </header>

  <section class="section shell">
    <div class="plate plate--cream glossary-plate">
      <Screws />
      <GlossarySearch client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(26px, 4vw, 52px) 0;
  }
  .mark {
    color: var(--brass);
  }
  .page-hero__lead {
    color: var(--parchment);
    font-size: clamp(18px, 1.7vw, 22px);
    max-width: 62ch;
    margin-top: 18px;
  }

  .glossary-plate :global(.glossary__search) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 26px;
  }
  .glossary-plate :global(.glossary__search label) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 14px;
    color: var(--cast-2);
  }
  .glossary-plate :global(.glossary__search input) {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 18px;
    padding: 14px 16px;
    border: 3px solid var(--cast);
    border-radius: 10px;
    background: #fff;
    color: var(--cast);
    max-width: 560px;
  }
  .glossary-plate :global(.glossary__search input:focus-visible) {
    outline: 3px solid var(--oxblood);
    outline-offset: 2px;
  }
  .glossary-plate :global(.glossary__empty) {
    color: var(--cast-2);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  .glossary-plate :global(.glossary__list) {
    margin: 0;
    display: grid;
    gap: 0;
  }
  .glossary-plate :global(.glossary__item) {
    padding: 18px 0;
    border-top: 2px solid rgba(46, 42, 36, 0.14);
  }
  .glossary-plate :global(.glossary__item dt) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 19px;
    font-weight: 600;
    color: var(--oxblood);
    margin-bottom: 6px;
  }
  .glossary-plate :global(.glossary__item dd) {
    margin: 0;
    color: var(--cast-2);
    max-width: 72ch;
  }
</style>
